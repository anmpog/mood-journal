datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  firstName    String
  lastName     String
  password     String
  JournalEntry JournalEntry[]
}

model JournalEntry {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime
  author       User     @relation(fields: [userId], references: [id])
  userId       Int
  moodRating   Int
  stressRating Int
  activities   String[]
  sleepHours   Int
  sleepQuality Int
}
