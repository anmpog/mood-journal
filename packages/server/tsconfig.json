{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDirs": ["src"],
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["../shared/src/*"] }
  },
  "references": [{ "path": "../shared" }],
  "include": ["src"]
}
